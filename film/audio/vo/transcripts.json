 },
 "L23": {
  "script": "晚安。你说过的，我都放在心上。",
  "heard": "晚安,你说过的我都放在心上。",
  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:03.200\n晚安,你说过的我都放在心上。\n"
 },
 "L24": {
  "script": "念念不忘，",
  "heard": "念念不忘",
  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:01.200\n念念不忘\n"
 },

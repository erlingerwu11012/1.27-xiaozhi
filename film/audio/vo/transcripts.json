  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:02.500\n周三要面试,有点紧张。\n"
 },
 "L18": {
  "script": "今天面试对吧？别紧张，你准备了那么久。",
  "heard": "今天面试,对吧? 别紧张,你准备了那么久。",
  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:01.900\n今天面试,对吧?\n\n00:00:01.900 --> 00:00:04.540\n别紧张,你准备了那么久。\n"
 },
 "L19": {
  "script": "名字，你来取。",
  "heard": "名字你来取。",
  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:01.800\n名字你来取。\n"
 },
 "L20": {
  "script": "换个样子，换个声音，也还是我。",
  "heard": "换个样子 换个声音 也还是我",
  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:03.200\n换个样子 换个声音 也还是我\n"
 },
 "L21": {
  "script": "自研 Harness 框架，自制硬件主板，接入你自己的大模型。",
  "heard": "自研Harness框架 自制硬件主板 接入你自己的大模型",
  "vtt": "WEBVTT\n\n00:00:00.000 --> 00:00:06.080\n自研Harness框架 自制硬件主板 接入你自己的大模型\n"
 },
 "L22": {
  "script": "晚安，小念。",

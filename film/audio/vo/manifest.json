  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033829_c28a79da-3676-433a-8452-1cdd65a842ab.wav"
 },
 "L05": {
  "text": "上周跟你说的面试……",
  "who": "U",
  "voice": "Yichen (zh)",
  "job": "85a2325f-1e39-403f-b9d8-8e5b22ac5868",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033843_85a2325f-1e39-403f-b9d8-8e5b22ac5868.wav"
 },
 "L06": {
  "text": "抱歉，我不太明白。",
  "who": "D",
  "voice": "Xinyi (zh)",
  "job": "7c842666-10ab-4a00-bb57-0c9fe0b1d0a5",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033859_7c842666-10ab-4a00-bb57-0c9fe0b1d0a5.wav"
 },
 "L07": {
  "text": "它们不主动，没温度，也记不住。",
  "who": "N",
  "voice": "Yichen (zh)",
  "job": "9141badc-e554-4bbd-bffd-23474d96f01a",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033914_9141badc-e554-4bbd-bffd-23474d96f01a.wav"
 },
 "L08": {
  "text": "可我们真正缺的，从来不是一台更聪明的机器，",
  "who": "N",
  "voice": "Yichen (zh)",
  "job": "90cee2c9-1c27-4e2c-8b8f-26107d8b42fe",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033926_90cee2c9-1c27-4e2c-8b8f-26107d8b42fe.wav"
 },
 "L09": {
  "text": "是一个，会陪着你的人。",
  "who": "N",
  "voice": "Yichen (zh)",
  "job": "72167b39-8584-4eb0-9035-ec2dd0214f08",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033939_72167b39-8584-4eb0-9035-ec2dd0214f08.wav"
 },
 "L10": {
  "text": "你好，小念。",
  "who": "U",
  "voice": "Yichen (zh)",
  "job": "d11a7580-ad86-4295-88f0-88d6d30a331e",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033953_d11a7580-ad86-4295-88f0-88d6d30a331e.wav"
 },
 "L11": {
  "text": "我在。",
  "who": "X",
  "voice": "Xiaoyin (zh)",
  "job": "41f4f023-19dc-4438-a318-3cef7e0bf5e2",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034008_41f4f023-19dc-4438-a318-3cef7e0bf5e2.wav"
 },
 "L12": {
  "text": "回来啦，今天过得怎么样？",
  "who": "X",
  "voice": "Xiaoyin (zh)",
  "job": "d0e8d5e3-29ce-4ca7-9ccc-dd270d1d476f",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034022_d0e8d5e3-29ce-4ca7-9ccc-dd270d1d476f.wav"
 },
 "L13": {
  "text": "今天有点累。",
  "who": "U",
  "voice": "Yichen (zh)",
  "job": "754ef7ee-33b0-4288-bdb2-128552395ea2",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034050_754ef7ee-33b0-4288-bdb2-128552395ea2.wav"
 },
 "L14": {
  "text": "那就先歇一会儿。想聊聊，还是我陪你安静待着？",
  "who": "X",
  "voice": "Xiaoyin (zh)",
  "job": "95dae3ba-b622-4c28-99dc-1df328b9aec6",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034104_95dae3ba-b622-4c28-99dc-1df328b9aec6.wav"
 },
 "L15": {
  "text": "安静待着吧，灯暗一点。",
  "who": "U",
  "voice": "Yichen (zh)",
  "job": "1cf6d81f-6d7d-4cbe-adf2-38f84f7034a6",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034118_1cf6d81f-6d7d-4cbe-adf2-38f84f7034a6.wav"
 },
 "L16": {
  "text": "好，台灯调暗了，客厅的灯也帮你关了。",
  "who": "X",
  "voice": "Xiaoyin (zh)",
  "job": "5d24c38f-5df2-450b-bc8e-3247dc67a392",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034131_5d24c38f-5df2-450b-bc8e-3247dc67a392.wav"
 },
 "L17": {
  "text": "周三要面试，有点紧张。",
  "who": "U",
  "voice": "Yichen (zh)",
  "job": "3b8d82da-2ebf-4100-8f2c-01ba11cb1f40",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034145_3b8d82da-2ebf-4100-8f2c-01ba11cb1f40.wav"
 },
 "L18": {
  "text": "今天面试对吧？别紧张，你准备了那么久。",
  "who": "X",
  "voice": "Xiaoyin (zh)",
  "job": "9d9b6460-309a-435d-a4ab-8d51bd29f68b",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_034159_9d9b6460-309a-435d-a4ab-8d51bd29f68b.wav"
 },
 "L19": {

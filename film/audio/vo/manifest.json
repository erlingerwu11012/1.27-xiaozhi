 },
 "L03": {
  "text": "今天有点累。",
  "who": "U",
  "voice": "Yichen (zh)",
  "job": "e32a835f-82b7-488e-a544-d34420679914",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3KizEQBKN5ExQDtX2zLZQJyBk1q/hf_20261018_033814_e32a835f-82b7-488e-a544-d34420679914.wav"
 },

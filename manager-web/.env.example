# Public, local development example. No server credentials are included.
# Copy to .env.local before running Vue CLI.
VUE_APP_TITLE=小念控制台
VUE_APP_API_BASE_URL=/xiaozhi
VUE_APP_PUBLIC_PATH=/
VUE_APP_PYTHON_API_URL=
VUE_APP_USE_CDN=false
VUE_DEV_PORT=8001
VUE_APP_PROXY_TARGET=http://127.0.0.1:8002
# Leave empty to preview the desktop application without mobile redirection.
VUE_APP_H5_URL=

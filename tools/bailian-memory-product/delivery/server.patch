+package xiaozhi.modules.useridentity;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+import java.util.HashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.springframework.jdbc.core.JdbcTemplate;
+import xiaozhi.modules.useridentity.service.AccountIdentityStateService;
+
+class AccountIdentityStateServiceTest {
+    private Map<String,Object> state(String mode,String id,long generation) {
+        Map<String,Object> state=new HashMap<>();
+        state.put("mode",mode);state.put("default_user_id",id);
+        state.put("default_generation",generation);state.put("directory_version",7L);
+        return state;
+    }
+    @Test void firstVoiceRetiresOnlyTheOldDefault() {
+        JdbcTemplate jdbc=mock(JdbcTemplate.class);
+        when(jdbc.queryForMap(contains("FOR UPDATE"),eq(10L))).thenReturn(state("default","usr_old",3));
+        when(jdbc.queryForObject(contains("COUNT(*)"),eq(Long.class),eq(10L))).thenReturn(1L);
+        new AccountIdentityStateService(jdbc).reconcile(10L);
+        verify(jdbc).update(contains("INSERT IGNORE INTO ai_identity_cleanup"),anyString(),eq(10L),eq("usr_old"),eq(3L),eq(8L));
+        verify(jdbc).update(contains("DELETE FROM ai_user_identity"),eq(10L),eq("usr_old"));
+        verify(jdbc).update(contains("mode='personal'"),eq(8L),eq(10L));
+    }
+    @Test void finalUnbindCreatesNewDefaultRatherThanReusingOld() {
+        JdbcTemplate jdbc=mock(JdbcTemplate.class);
+        when(jdbc.queryForMap(contains("FOR UPDATE"),eq(10L))).thenReturn(state("personal",null,3));
+        when(jdbc.queryForObject(contains("COUNT(*)"),eq(Long.class),eq(10L))).thenReturn(0L);
+        new AccountIdentityStateService(jdbc).reconcile(10L);
+        verify(jdbc).update(contains("INSERT INTO ai_user_identity"),eq(10L),matches("usr_[a-f0-9]{32}"));
+        verify(jdbc).update(contains("default_generation=default_generation+1"),matches("usr_[a-f0-9]{32}"),eq(10L));
+        verify(jdbc,never()).update(contains("DELETE FROM ai_user_identity"),any(),any());
+    }
+    @Test void personalModeDoesNotRecreateDefaultWhileVoicesExist() {
+        JdbcTemplate jdbc=mock(JdbcTemplate.class);
+        when(jdbc.queryForMap(contains("FOR UPDATE"),eq(10L))).thenReturn(state("personal",null,3));
+        when(jdbc.queryForObject(contains("COUNT(*)"),eq(Long.class),eq(10L))).thenReturn(2L);
+        new AccountIdentityStateService(jdbc).reconcile(10L);
+        verify(jdbc,never()).update(contains("INSERT INTO ai_user_identity"),any(),any());
+    }
+    @Test void stableIdIsGeneratedAndSafe() {
+        String first=AccountIdentityStateService.newId();
+        assertTrue(first.matches("usr_[a-f0-9]{32}"));
+        assertNotEquals(first,AccountIdentityStateService.newId());
+    }
+}

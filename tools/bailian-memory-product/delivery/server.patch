+package xiaozhi.modules.personmemory;
+
+import static org.junit.jupiter.api.Assertions.*;
+import java.util.*;
+import org.junit.jupiter.api.Test;
+
+class MemoryDailyWorkerTest {
+    @Test void pendingAndRunningAreNotCompletion() {
+        Set<String> states=MemoryDailyWorker.eventStates(Map.of("events",List.of(Map.of("status","SUCCEEDED"),Map.of("status","RUNNING"))));
+        assertFalse(states.stream().allMatch("SUCCEEDED"::equals));
+        assertEquals(Set.of("SUCCEEDED","RUNNING"),states);
+    }
+    @Test void failureIsDetectedAmongSeveralResources() {
+        assertTrue(MemoryDailyWorker.eventStates(Map.of("events",List.of(Map.of("status","SUCCEEDED"),Map.of("status","FAILED")))).contains("FAILED"));
+    }
+    @Test void emptyEventDoesNotMeanDone() {
+        assertTrue(MemoryDailyWorker.eventStates(Map.of("request_id","synthetic")).isEmpty());
+    }
+    @Test void completionAcceptsSingleEventShape() {
+        assertEquals(Set.of("SUCCEEDED"),MemoryDailyWorker.eventStates(Map.of("status","SUCCEEDED")));
+    }
+}

+package xiaozhi.modules.personmemory;
+import static org.junit.jupiter.api.Assertions.*;
+import java.time.*;
+import java.util.*;
+import org.junit.jupiter.api.Test;
+
+class PersonBehaviorServiceTest {
+    @Test void crossDeviceRowsUseBeijingCalendarAndRealOutcomes() {
+        List<Map<String,Object>> rows=new ArrayList<>();
+        for(int day=1;day<=5;day++)for(int device=0;device<2;device++) {
+            long timestamp=LocalDate.of(2026,9,day).atTime(8,30).atZone(ZoneId.of("Asia/Shanghai")).toEpochSecond();
+            rows.add(Map.of("occurred_at",timestamp,"raw_text","提醒喝水：设备"+device,"outcome",device==0?"executed":"failed","intent","drink_water"));
+        }
+        var summaries=PersonBehaviorService.summarize(rows);
+        assertEquals(1,summaries.size());assertEquals(8,summaries.getFirst().get("hour"));
+        assertEquals(5,summaries.getFirst().get("days_active"));assertEquals(10,summaries.getFirst().get("total_count"));
+        assertTrue(summaries.toString().contains("failed")); // No invented success.
+    }
+    @Test void singleDayBurstDoesNotBecomeHabit() {
+        var row=Map.<String,Object>of("occurred_at",1788222600L,"raw_text","一时兴起","outcome","conversation");
+        assertTrue(PersonBehaviorService.summarize(Collections.nCopies(20,row)).isEmpty());
+    }
+}

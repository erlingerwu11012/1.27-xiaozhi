+    dsn:="root:"+os.Getenv("MEMORY_MYSQL_TEST_PASSWORD")+"@tcp(127.0.0.1:3306)/"+database+"?charset=utf8mb4&parseTime=True&loc=Local"
+    db,e:=gorm.Open(mysql.Open(dsn),&gorm.Config{Logger:glog.Default.LogMode(glog.Silent)});if e!=nil{t.Fatal("test database connection failed")}
+    sql,_:=db.DB();defer sql.Close();sql.SetMaxOpenConns(8)

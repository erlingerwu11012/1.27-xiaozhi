+        encoded,_:=json.Marshal(result)
+        return &http.Response{StatusCode:200,Header:make(http.Header),Body:io.NopCloser(strings.NewReader(string(encoded)))},nil
+    })}
+    payload:=`{"messages":[{"role":"user","content":"synthetic"}],"user_id":"foreign","plan_version":"pro","top_k":99}`
+    if out:=request("POST","/memory_nodes/search","usr_a","search-01",payload,key,1);out.Code!=200 {t.Fatal(out.Code,out.Body.String())}
+    if out:=request("POST","/memory_nodes/search","usr_a","search-01",payload,key,1);out.Code!=200 || out.Header().Get("X-Memory-Replay")!="1" {t.Fatal("replay failed",out.Code,out.Body.String())}
+    if calls!=1 {t.Fatal("duplicate upstream search")}
+    if out:=request("POST","/memory_nodes/search","usr_a","search-01",`{"messages":[]}`,key,1);out.Code!=409 {t.Fatal("payload conflict accepted",out.Code)}
+    if out:=request("GET","/memory_nodes/owned_node","usr_b","","",key,1);out.Code!=403 {t.Fatal("cross-person read accepted",out.Code)}
+    if out:=request("GET","/memory_nodes/owned_node","usr_a","","",otherKey,1);out.Code!=403 {t.Fatal("cross-wallet attestation accepted",out.Code)}
+    if out:=request("POST","/add-async","usr_a","fact-001",`{"messages":[{"role":"user","content":"synthetic fact"}]}`,key,1);out.Code!=200 {t.Fatal(out.Code,out.Body.String())}
+    if calls!=2 {t.Fatal("unexpected call count",calls)}
+    var user model.User;db.First(&user,1)
+    // Search + fact = (0.00002 + 0.018) * 1.43 * 500000/7 = 1840.614285 quota.
+    if user.UsedQuota!=1840 || user.Quota!=100000-1840 {t.Fatal("multiplier or rounding incorrect",user.UsedQuota,user.Quota)}
+    var other model.User;db.First(&other,2);if other.Quota!=100000 {t.Fatal("other account charged")}
+    unknown=true
+    if out:=request("POST","/memory_nodes/search","usr_a","lost-001",payload,key,1);out.Code!=502 {t.Fatal("unknown result not held",out.Code)}
+    if out:=request("POST","/memory_nodes/search","usr_a","lost-001",payload,key,1);out.Code!=409 {t.Fatal("unknown result repeated",out.Code)}
+    if calls!=3 {t.Fatal("blind resubmission after response loss")}
+    var reviews int64;db.Model(&MemoryRequest{}).Where("state = ?","review").Count(&reviews)
+    if reviews!=1 {t.Fatal("missing durable review")}
+}

+            status,result:=call("GET","/events/"+event,person,"",nil)
+            if status!=200 {return false}
+            states:=[]string{}
+            if list,ok:=result["events"].([]interface{});ok {for _,item:=range list {if row,ok:=item.(map[string]interface{});ok {states=append(states,str(row["status"]))}}}
+            if state,ok:=result["status"].(string);ok {states=append(states,state)}
+            complete:=len(states)>0;for _,state:=range states {if state=="FAILED" || state=="UNRECORDED" {return false};complete=complete && state=="SUCCEEDED"}
+            if complete {return true};time.Sleep(2*time.Second)
+        }
+        return false
+    }
+    cleanup:=func(person string)bool {

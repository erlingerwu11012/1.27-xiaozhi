+        if status!=200 {t.Fatal("Search failed",status,result["error"])}
+        nodes,_=result["memory_nodes"].([]interface{});if len(nodes)==0 {t.Fatal("Search found no known preference")}
+        text,_:=json.Marshal(nodes);if i==0 && strings.Contains(string(text),"拿铁") || i==1 && strings.Contains(string(text),"茉莉") {t.Fatal("persons crossed")}
+        report[person+"_search_plan"]=result["plan_version"]

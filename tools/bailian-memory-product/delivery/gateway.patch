+        request.Header.Set("Authorization","Bearer sk-"+key)
+        expiry:=strconv.FormatInt(time.Now().Unix()+120,10)
+        request.Header.Set("X-Memory-Account","99100001");request.Header.Set("X-Memory-Person",person)
+        request.Header.Set("X-Memory-Generation","0");request.Header.Set("X-Memory-Expires",expiry)
+        request.Header.Set("X-Memory-Signature",memoryAttestation(strings.Repeat("s",32),1,"99100001",person,"0",expiry))
+        request.Header.Set("Idempotency-Key",idem)
+        response:=httptest.NewRecorder();router.ServeHTTP(response,request)
+        var result map[string]interface{};data,_:=io.ReadAll(response.Body);json.Unmarshal(data,&result)
+        return response.Code,result
+    }
+    persons:=[]string{"test_"+strings.ReplaceAll(uuid.NewString(),"-",""),"test_"+strings.ReplaceAll(uuid.NewString(),"-","")}
+    events:=map[string]string{}
+    wait:=func(person,event string)bool {

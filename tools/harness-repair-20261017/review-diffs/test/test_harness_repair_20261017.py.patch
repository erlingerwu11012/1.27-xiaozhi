+class ReplyTests(unittest.IsolatedAsyncioTestCase):
+    def harness(self, decision=None):
+        harness = SimpleNamespace(conn=SimpleNamespace(config={}), _speech_output=None,
+                                  observe=MagicMock(), catalog=lambda: {},
+                                  decide=decision or MagicMock(side_effect=AssertionError('unnecessary model call')),
+                                  stream_decide=None)
+        return harness
+
+    async def test_verified_setting_skips_result_model(self):
+        for tool, payload, text in [
+            ('self_screen_set_brightness', {'brightness': 3, 'brightness_level': 3}, '亮度已调到3档。'),
+            ('self_audio_speaker_set_volume', {'volume': 20}, '音量已调到20。')]:
+            harness = self.harness()
+            result = StepResult(state='completed', tool=tool, call_id='x', arguments={}, reply=text, payload=payload)
+            outcome = OperationOutcome(mode='operate', reply=text, results=[result], model_calls=1)
+            await compose(harness, '调低一点', [], outcome, time.monotonic()+10)
+            self.assertEqual(outcome.model_calls, 1)
+            harness.decide.assert_not_called()
+
+    async def test_failure_keeps_result_model_and_checks_success_claim(self):
+        decide = MagicMock(return_value={'mode': 'chat', 'reply': '已经完成，搞定了。'})
+        harness = self.harness(decide)
+        result = StepResult(state='failed', tool='self_screen_set_brightness', call_id='x', arguments={}, reply='亮度没有完成。')
+        outcome = OperationOutcome(mode='operate', reply='亮度没有完成。', results=[result])
+        await compose(harness, '调低一点', [], outcome, time.monotonic()+10)
+        decide.assert_called_once()
+        self.assertEqual(outcome.reply, '亮度没有完成。')
+
+    async def test_interrupted_reply_has_no_model_or_completion(self):
+        harness = self.harness()
+        outcome = OperationOutcome(mode='operate', reply='', interrupted=True, results=[])
+        await compose(harness, '', [], outcome, time.monotonic()+10)
+        harness.decide.assert_not_called()
+
+
+class HarnessFlowTests(unittest.IsolatedAsyncioTestCase):
+    async def test_absolute_setting_end_to_end_without_model(self):
+        from core.utils.person_identity import PersonTurn, activate, deactivate
+        from core.utils.tool_harness.runtime import Harness
+        from core.utils.tool_harness.ledger import Ledger
+        conn = connection()
+        conn.person_turn = PersonTurn('1', 'usr_test', 0, 1, 'personal', 'matched', 'turn-setting',
+                                     conn.device_id, 'agent-test', 1)
+        manager, executor = CatalogTests().manager(conn)
+        setting = ToolDefinition('self_audio_speaker_set_volume', {'type': 'function', 'function': {
+            'name': 'self_audio_speaker_set_volume', 'description': '设置音量', 'parameters': {
+                'type': 'object', 'properties': {'volume': {'type': 'integer', 'minimum': 0, 'maximum': 100}},
+                'required': ['volume'], 'additionalProperties': False}}}, ToolType.DEVICE_MCP)
+        executor.get_tools.return_value['self_audio_speaker_set_volume'] = setting
+        executor.execute = AsyncMock(return_value=ActionResponse(Action.REQLLM, result=json.dumps({'ok': True, 'volume': 20})))
+        conn.func_handler = SimpleNamespace(tool_manager=manager)
+        decide = MagicMock(side_effect=AssertionError('simple setting must not need a model'))
+        ledger = Ledger(':memory:')
+        harness = Harness(conn, ledger=ledger, decide=decide)
+        token = activate(conn, conn.person_turn)
+        try:
+            outcome = await harness.run('把音量调到20', [])
+            self.assertFalse(outcome.error, outcome.error)
+            self.assertTrue(any(r.tool == setting.name and r.state == 'completed' for r in outcome.results), outcome)
+            self.assertEqual(outcome.model_calls, 0)
+            decide.assert_not_called()
+            self.assertEqual(executor.execute.await_count, 1)
+        finally:
+            deactivate(token)
+            ledger.close()
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
